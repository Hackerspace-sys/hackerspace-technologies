---
import Logo from './Logo.astro';
import { siteConfig } from '../data/site';
import { ventures } from '../data/ventures';
import { getPath } from '../utils/paths';

const currentYear = new Date().getFullYear();
const featuredVentures = ventures.slice(0, 5);
---

<footer class="bg-[#050505] text-neutral-400 border-t border-white/10 pt-16 pb-12 relative overflow-hidden" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  
  <!-- Subtle decorative background accent -->
  <div class="absolute -top-32 right-10 w-96 h-96 bg-hst-red/5 rounded-full blur-3xl pointer-events-none" />

  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      
      <!-- Company Brand Column (lg:col-span-5) -->
      <div class="lg:col-span-5 space-y-6">
        <Logo variant="dark" height={36} />
        
        <p class="text-sm leading-relaxed text-neutral-400 max-w-sm font-sans">
          {siteConfig.mission}
        </p>

        <div class="pt-2">
          <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-neutral-300 font-mono">
            <span class="w-2 h-2 rounded-full bg-hst-red animate-pulse-subtle"></span>
            <span>Independent Technology Organization</span>
          </div>
        </div>
      </div>

      <!-- Navigation Links (lg:col-span-2) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-xs font-mono font-semibold tracking-widest uppercase text-white">
          Company
        </h3>
        <ul class="space-y-2.5 text-sm" role="list">
          {siteConfig.navItems.map((item) => (
            <li>
              <a 
                href={getPath(item.href)}
                class="hover:text-white transition-colors duration-200 focus-visible:ring-1 focus-visible:ring-hst-red"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Ventures Portfolio (lg:col-span-3) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-xs font-mono font-semibold tracking-widest uppercase text-white">
          Ventures Ecosystem
        </h3>
        <ul class="space-y-2.5 text-sm" role="list">
          {featuredVentures.map((v) => (
            <li>
              <a 
                href={getPath(`/ventures/${v.slug}`)}
                class="group inline-flex items-center gap-1.5 hover:text-white transition-colors duration-200 focus-visible:ring-1 focus-visible:ring-hst-red"
              >
                <span>{v.name}</span>
                <span class="text-[10px] text-neutral-600 font-mono group-hover:text-hst-red transition-colors">↗</span>
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a 
              href={getPath('/ventures')} 
              class="text-xs font-semibold text-hst-red hover:underline inline-flex items-center gap-1"
            >
              View Full Portfolio →
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact & Communication (lg:col-span-2) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-xs font-mono font-semibold tracking-widest uppercase text-white">
          Inquiries
        </h3>
        <p class="text-xs text-neutral-400 leading-relaxed">
          Open to technical collaborations, product inquiries, and strategic discussions.
        </p>
        <div class="pt-1">
          <a
            href={getPath('/contact')}
            class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-white hover:text-hst-red transition-colors"
          >
            Initiate Contact →
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-neutral-500">
      <div class="flex items-center gap-2">
        <span>© {currentYear} HackerSpace Technologies (HST).</span>
        <span class="hidden sm:inline">•</span>
        <span>All Rights Reserved.</span>
      </div>

      <div class="flex items-center gap-6">
        <a href={getPath('/privacy')} class="hover:text-neutral-300 transition-colors">Privacy Policy</a>
        <a href={getPath('/terms')} class="hover:text-neutral-300 transition-colors">Terms of Use</a>
        <button
          type="button"
          id="back-to-top"
          class="hover:text-white transition-colors flex items-center gap-1 focus-visible:ring-1 focus-visible:ring-hst-red"
          aria-label="Back to top of page"
        >
          <span>Top</span>
          <span>↑</span>
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  setupBackToTop();
  document.addEventListener('astro:page-load', setupBackToTop);
</script>
