---
import Logo from './Logo.astro';
import { siteConfig } from '../data/site';

interface Props {
  currentPath?: string;
  theme?: 'dark' | 'light';
}

const { currentPath = Astro.url.pathname, theme = 'dark' } = Astro.props;

function isActive(href: string): boolean {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
}
---

<header 
  id="main-header"
  class="sticky top-0 z-50 w-full transition-all duration-300 border-b border-white/10 bg-[#050505]/90 backdrop-blur-md"
  data-theme={theme}
>
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <div class="flex-shrink-0">
      <Logo variant="dark" height={32} />
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Main Navigation">
      {siteConfig.navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`relative px-3.5 py-2 text-sm font-medium transition-colors duration-200 rounded-md focus-visible:ring-2 focus-visible:ring-hst-red ${
              active 
                ? 'text-white font-semibold' 
                : 'text-neutral-400 hover:text-white'
            }`}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
            {active && (
              <span class="absolute bottom-0 left-3.5 right-3.5 h-[2px] bg-hst-red rounded-full" />
            )}
          </a>
        );
      })}
    </nav>

    <!-- Header Action CTA -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="/contact"
        class="group relative inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold tracking-wider uppercase text-white bg-transparent border border-white/20 hover:border-hst-red transition-all duration-300 overflow-hidden focus-visible:ring-2 focus-visible:ring-hst-red"
      >
        <span class="absolute inset-0 bg-hst-red translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out" />
        <span class="relative z-10 flex items-center gap-2">
          Let's Connect
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex md:hidden">
      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex items-center justify-center p-2.5 text-neutral-400 hover:text-white hover:bg-white/5 rounded-md focus-visible:ring-2 focus-visible:ring-hst-red"
        aria-controls="mobile-menu-drawer"
        aria-expanded="false"
        aria-label="Open main menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Overlay & Panel -->
  <div 
    id="mobile-menu-drawer" 
    class="fixed inset-0 top-20 z-40 bg-[#050505]/98 backdrop-blur-xl md:hidden transition-all duration-300 opacity-0 pointer-events-none translate-x-full"
    aria-hidden="true"
  >
    <div class="max-w-site mx-auto px-6 py-8 flex flex-col justify-between h-[calc(100vh-5rem)]">
      <nav class="flex flex-col space-y-4" aria-label="Mobile Navigation">
        <span class="text-[11px] font-mono tracking-widest text-neutral-500 uppercase pb-2 border-b border-white/10">
          Directory
        </span>
        {siteConfig.navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`flex items-center justify-between py-3 text-xl font-medium tracking-tight border-b border-white/5 transition-colors ${
                active ? 'text-hst-red font-semibold' : 'text-neutral-300 hover:text-white'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              <span>{item.label}</span>
              <span class="text-xs font-mono text-neutral-600">→</span>
            </a>
          );
        })}
      </nav>

      <div class="pt-8 border-t border-white/10 flex flex-col space-y-4">
        <a
          href="/contact"
          class="w-full py-4 text-center text-sm font-semibold tracking-wider uppercase text-white bg-hst-red hover:bg-hst-red-hover transition-colors rounded-sm shadow-lg shadow-hst-red/20"
        >
          Have an Idea Worth Building?
        </a>
        <p class="text-xs text-neutral-500 text-center font-mono">
          HackerSpace Technologies — Building What's Next.
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!toggleBtn || !drawer || !hamburgerIcon || !closeIcon) return;

    let isOpen = false;

    function toggleMenu(open?: boolean) {
      isOpen = typeof open === 'boolean' ? open : !isOpen;
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
      toggleBtn.setAttribute('aria-label', isOpen ? 'Close main menu' : 'Open main menu');
      drawer.setAttribute('aria-hidden', String(!isOpen));

      if (isOpen) {
        drawer.classList.remove('opacity-0', 'pointer-events-none', 'translate-x-full');
        drawer.classList.add('opacity-100', 'pointer-events-auto', 'translate-x-0');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      } else {
        drawer.classList.add('opacity-0', 'pointer-events-none', 'translate-x-full');
        drawer.classList.remove('opacity-100', 'pointer-events-auto', 'translate-x-0');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    toggleBtn.addEventListener('click', () => toggleMenu());

    // Close menu on ESC key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggleMenu(false);
      }
    });

    // Close menu on link click inside drawer
    const links = drawer.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });
  }

  // Setup on initial load and View Transitions
  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
