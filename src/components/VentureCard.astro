---
import type { Venture } from '../data/ventures';

interface Props {
  venture: Venture;
  theme?: 'dark' | 'light';
  featuredLayout?: boolean;
}

const { venture, theme = 'light', featuredLayout = false } = Astro.props;
const isDark = theme === 'dark';

// Status colors
const statusBadges = {
  live: {
    bg: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
    dot: 'bg-emerald-500'
  },
  'in-development': {
    bg: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20',
    dot: 'bg-amber-500'
  },
  concept: {
    bg: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20',
    dot: 'bg-blue-500'
  },
  incubation: {
    bg: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20',
    dot: 'bg-purple-500'
  }
};

const badge = statusBadges[venture.statusType] || statusBadges.concept;
---

<article 
  class={`group relative flex flex-col justify-between p-6 sm:p-8 rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 ${
    isDark 
      ? 'bg-[#111113] border-white/10 hover:border-hst-red/50 hover:shadow-hst-red/5' 
      : 'bg-white border-neutral-200 hover:border-hst-red/40 hover:shadow-neutral-200/80'
  } ${featuredLayout ? 'lg:col-span-2' : ''}`}
>
  <div>
    <!-- Top Meta Bar: Category + Status Badge -->
    <div class="flex items-center justify-between gap-2 pb-5 border-b mb-6 ${isDark ? 'border-white/5' : 'border-neutral-100'}">
      <span class="text-xs font-mono font-medium tracking-wider uppercase text-neutral-500">
        {venture.category}
      </span>
      <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono border ${badge.bg}`}>
        <span class={`w-1.5 h-1.5 rounded-full ${badge.dot}`}></span>
        <span>{venture.status}</span>
      </span>
    </div>

    <!-- Venture Name & One-Liner -->
    <h3 class={`text-xl sm:text-2xl font-bold tracking-tight mb-3 transition-colors group-hover:text-hst-red ${
      isDark ? 'text-white' : 'text-neutral-900'
    }`}>
      <a href={`/ventures/${venture.slug}`} class="focus:outline-none focus-visible:ring-1 focus-visible:ring-hst-red">
        {venture.name}
      </a>
    </h3>

    <p class={`text-sm sm:text-base leading-relaxed mb-6 ${
      isDark ? 'text-neutral-400' : 'text-neutral-600'
    }`}>
      {venture.oneLiner}
    </p>
  </div>

  <!-- Footer Disciplines + Link -->
  <div class="pt-6 border-t ${isDark ? 'border-white/5' : 'border-neutral-100'} flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex flex-wrap gap-1.5">
      {venture.techDisciplines.slice(0, 3).map((disc) => (
        <span class={`text-[11px] font-mono px-2 py-0.5 rounded ${
          isDark ? 'bg-white/5 text-neutral-400' : 'bg-neutral-100 text-neutral-600'
        }`}>
          {disc}
        </span>
      ))}
    </div>

    <a 
      href={`/ventures/${venture.slug}`}
      class="inline-flex items-center gap-1 text-xs font-mono font-semibold uppercase tracking-wider text-hst-red hover:underline"
      aria-label={`View ${venture.name} technical overview`}
    >
      <span>Dossier</span>
      <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
    </a>
  </div>
</article>
