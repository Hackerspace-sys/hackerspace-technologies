---
import { siteConfig } from '../data/site';

interface Props {
  theme?: 'dark' | 'light';
  id?: string;
}

const { theme = 'dark', id = 'contact-form' } = Astro.props;
const isDark = theme !== 'light';
---

<div class={`p-6 sm:p-10 rounded-xl border ${
  isDark ? 'bg-[#121212] border-white/10 shadow-2xl' : 'bg-white border-neutral-200 shadow-sm'
}`}>
  <div class="mb-8">
    <h3 class={`text-2xl font-bold tracking-tight mb-2 ${isDark ? 'text-white' : 'text-neutral-900'}`}>
      Initiate an Inquiry
    </h3>
    <p class={`text-sm ${isDark ? 'text-neutral-400' : 'text-neutral-600'}`}>
      Direct line to HackerSpace Technologies leadership and engineering.
    </p>
  </div>

  <form id={id} class="space-y-6" novalidate>
    <!-- Honeypot anti-spam (invisible to humans) -->
    <div class="hidden" aria-hidden="true">
      <label for="company_website_hp">Do not fill this</label>
      <input type="text" id="company_website_hp" name="company_website_hp" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Name & Email (2 columns on sm+) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label for="name" class={`block text-xs font-mono font-medium uppercase tracking-wider ${
          isDark ? 'text-neutral-300' : 'text-neutral-700'
        }`}>
          Your Name <span class="text-hst-red">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Alex / Lakshmi"
          class={`w-full px-4 py-3 text-sm rounded-md border transition-colors focus:outline-none focus:ring-2 focus:ring-hst-red ${
            isDark 
              ? 'bg-[#181818] border-white/10 text-white placeholder-neutral-500 focus:border-hst-red' 
              : 'bg-neutral-50 border-neutral-300 text-neutral-900 placeholder-neutral-400 focus:border-transparent'
          }`}
        />
        <p class="text-xs text-hst-red hidden field-error" id="name-error">Please provide your name.</p>
      </div>

      <div class="space-y-2">
        <label for="email" class={`block text-xs font-mono font-medium uppercase tracking-wider ${
          isDark ? 'text-neutral-300' : 'text-neutral-700'
        }`}>
          Email Address <span class="text-hst-red">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="name@domain.com"
          class={`w-full px-4 py-3 text-sm rounded-md border transition-colors focus:outline-none focus:ring-2 focus:ring-hst-red ${
            isDark 
              ? 'bg-[#181818] border-white/10 text-white placeholder-neutral-500 focus:border-hst-red' 
              : 'bg-neutral-50 border-neutral-300 text-neutral-900 placeholder-neutral-400 focus:border-transparent'
          }`}
        />
        <p class="text-xs text-hst-red hidden field-error" id="email-error">Please provide a valid email address.</p>
      </div>
    </div>

    <!-- Organization & Inquiry Type -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="space-y-2">
        <label for="organization" class={`block text-xs font-mono font-medium uppercase tracking-wider ${
          isDark ? 'text-neutral-300' : 'text-neutral-700'
        }`}>
          Organization / Entity <span class="text-neutral-500 lowercase">(optional)</span>
        </label>
        <input
          type="text"
          id="organization"
          name="organization"
          placeholder="Company or institution"
          class={`w-full px-4 py-3 text-sm rounded-md border transition-colors focus:outline-none focus:ring-2 focus:ring-hst-red ${
            isDark 
              ? 'bg-[#181818] border-white/10 text-white placeholder-neutral-500 focus:border-hst-red' 
              : 'bg-neutral-50 border-neutral-300 text-neutral-900 placeholder-neutral-400 focus:border-transparent'
          }`}
        />
      </div>

      <div class="space-y-2">
        <label for="inquiryType" class={`block text-xs font-mono font-medium uppercase tracking-wider ${
          isDark ? 'text-neutral-300' : 'text-neutral-700'
        }`}>
          Inquiry Classification
        </label>
        <select
          id="inquiryType"
          name="inquiryType"
          class={`w-full px-4 py-3 text-sm rounded-md border transition-colors focus:outline-none focus:ring-2 focus:ring-hst-red ${
            isDark 
              ? 'bg-[#181818] border-white/10 text-white focus:border-hst-red' 
              : 'bg-neutral-50 border-neutral-300 text-neutral-900 focus:border-transparent'
          }`}
        >
          {siteConfig.contact.inquiryTypes.map(t => (
            <option value={t.value}>{t.label}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Message -->
    <div class="space-y-2">
      <label for="message" class={`block text-xs font-mono font-medium uppercase tracking-wider ${
        isDark ? 'text-neutral-300' : 'text-neutral-700'
      }`}>
        Message / Brief <span class="text-hst-red">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        required
        rows={4}
        placeholder="Describe the opportunity, technical inquiry, or collaboration idea..."
        class={`w-full px-4 py-3 text-sm rounded-md border transition-colors focus:outline-none focus:ring-2 focus:ring-hst-red ${
          isDark 
            ? 'bg-[#151518] border-white/15 text-white placeholder-neutral-600 focus:border-transparent' 
            : 'bg-neutral-50 border-neutral-300 text-neutral-900 placeholder-neutral-400 focus:border-transparent'
        }`}
      ></textarea>
      <p class="text-xs text-hst-red hidden field-error" id="message-error">Please provide a message.</p>
    </div>

    <!-- Privacy Consent -->
    <div class="flex items-start gap-3 pt-2">
      <input
        type="checkbox"
        id="privacyConsent"
        name="privacyConsent"
        required
        class="mt-1 h-4 w-4 rounded border-neutral-300 text-hst-red focus:ring-hst-red"
      />
      <label for="privacyConsent" class={`text-xs leading-relaxed ${isDark ? 'text-neutral-400' : 'text-neutral-600'}`}>
        I agree to the processing of this inquiry in accordance with the HST <a href="/privacy" class="text-hst-red hover:underline underline-offset-2">Privacy Policy</a>.
      </label>
    </div>
    <p class="text-xs text-hst-red hidden field-error" id="consent-error">You must accept the privacy policy to proceed.</p>

    <!-- Submission feedback boxes -->
    <div id="form-success" class="hidden p-4 rounded-md bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-sm">
      <div class="flex items-center gap-2 font-semibold mb-1">
        <span>✓</span>
        <span>Inquiry Prepared Successfully</span>
      </div>
      <p class="text-xs">
        Your transmission has been processed. A mail client dispatch has also been initiated for redundant delivery. We will respond deliberately.
      </p>
    </div>

    <div id="form-error" class="hidden p-4 rounded-md bg-hst-red/10 border border-hst-red/30 text-hst-red text-sm">
      <div class="flex items-center gap-2 font-semibold mb-1">
        <span>⚠</span>
        <span>Validation or Dispatch Notice</span>
      </div>
      <p class="text-xs" id="form-error-msg">
        Please verify all required fields. You can also reach our desk directly at <a href="mailto:contact@hackerspace.technologies" class="underline font-mono">contact@hackerspace.technologies</a>.
      </p>
    </div>

    <!-- Submit Button -->
    <button
      type="submit"
      id="submit-button"
      class="w-full sm:w-auto px-8 py-3.5 text-xs font-semibold tracking-widest uppercase text-white bg-hst-red hover:bg-hst-red-hover transition-all duration-200 rounded-sm shadow-md hover:shadow-lg hover:shadow-hst-red/20 focus-visible:ring-2 focus-visible:ring-hst-red flex items-center justify-center gap-3 cursor-pointer"
    >
      <span id="btn-text">Transmit Inquiry</span>
      <span id="btn-spinner" class="hidden animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
      <span id="btn-arrow" class="transition-transform group-hover:translate-x-1">→</span>
    </button>
  </form>
</div>

<script>
  function setupContactForm() {
    const form = document.querySelector('form[id^="contact-form"]') as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Reset errors
      form.querySelectorAll('.field-error').forEach(el => el.classList.add('hidden'));
      const successBox = form.querySelector('#form-success');
      const errorBox = form.querySelector('#form-error');
      const btnText = form.querySelector('#btn-text');
      const btnSpinner = form.querySelector('#btn-spinner');
      const btnArrow = form.querySelector('#btn-arrow');
      const submitBtn = form.querySelector('#submit-button') as HTMLButtonElement;

      if (successBox) successBox.classList.add('hidden');
      if (errorBox) errorBox.classList.add('hidden');

      // Honeypot check
      const hp = (form.querySelector('#company_website_hp') as HTMLInputElement)?.value;
      if (hp) {
        // Silent bot rejection
        return;
      }

      // Fields
      const name = (form.querySelector('#name') as HTMLInputElement)?.value.trim();
      const email = (form.querySelector('#email') as HTMLInputElement)?.value.trim();
      const organization = (form.querySelector('#organization') as HTMLInputElement)?.value.trim();
      const inquiryType = (form.querySelector('#inquiryType') as HTMLSelectElement)?.value;
      const message = (form.querySelector('#message') as HTMLTextAreaElement)?.value.trim();
      const consent = (form.querySelector('#privacyConsent') as HTMLInputElement)?.checked;

      let hasError = false;

      if (!name) {
        form.querySelector('#name-error')?.classList.remove('hidden');
        hasError = true;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailRegex.test(email)) {
        form.querySelector('#email-error')?.classList.remove('hidden');
        hasError = true;
      }

      if (!message || message.length < 5) {
        form.querySelector('#message-error')?.classList.remove('hidden');
        hasError = true;
      }

      if (!consent) {
        form.querySelector('#consent-error')?.classList.remove('hidden');
        hasError = true;
      }

      if (hasError) return;

      // Loading state
      if (btnText) btnText.textContent = 'Transmitting...';
      if (btnSpinner) btnSpinner.classList.remove('hidden');
      if (btnArrow) btnArrow.classList.add('hidden');
      if (submitBtn) submitBtn.disabled = true;

      // Simulate verification / direct mailto dispatch fallback
      setTimeout(() => {
        if (btnText) btnText.textContent = 'Transmitted';
        if (btnSpinner) btnSpinner.classList.add('hidden');
        if (successBox) successBox.classList.remove('hidden');

        // Create direct mailto trigger so no inquiry is ever lost
        const subject = encodeURIComponent(`[HST Inquiry: ${inquiryType}] from ${name} (${organization || 'Individual'})`);
        const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nOrganization: ${organization}\nInquiry Type: ${inquiryType}\n\nMessage:\n${message}`);
        
        // Open background mailto after brief delay
        setTimeout(() => {
          window.location.href = `mailto:contact@hackerspace.technologies?subject=${subject}&body=${body}`;
        }, 800);

        form.reset();
        if (submitBtn) submitBtn.disabled = false;
        if (btnText) btnText.textContent = 'Transmit Inquiry';
        if (btnArrow) btnArrow.classList.remove('hidden');
      }, 700);
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
