---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  theme?: 'dark' | 'light';
  align?: 'left' | 'center';
  className?: string;
}

const {
  eyebrow,
  title,
  description,
  theme = 'light',
  align = 'left',
  className = ''
} = Astro.props;

const isDark = theme === 'dark';
const alignClass = align === 'center' ? 'text-center mx-auto items-center' : 'text-left items-start';
---

<div class={`flex flex-col space-y-4 max-w-3xl ${alignClass} ${className}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono tracking-widest uppercase rounded-full border border-current/10 w-fit">
      <span class="w-1.5 h-1.5 rounded-full bg-hst-red"></span>
      <span class={isDark ? 'text-neutral-400' : 'text-neutral-600'}>
        {eyebrow}
      </span>
    </div>
  )}

  <h2 class={`text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] ${
    isDark ? 'text-white' : 'text-neutral-900'
  }`}>
    {title}
  </h2>

  {description && (
    <p class={`text-base sm:text-lg leading-relaxed ${
      isDark ? 'text-neutral-400' : 'text-neutral-600'
    }`}>
      {description}
    </p>
  )}
</div>
