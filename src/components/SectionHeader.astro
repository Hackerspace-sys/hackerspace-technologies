---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  theme?: 'dark' | 'light';
  align?: 'left' | 'center';
  className?: string;
}

const {
  eyebrow,
  title,
  description,
  theme = 'dark',
  align = 'left',
  className = ''
} = Astro.props;

const isDark = theme !== 'light';
const alignClass = align === 'center' ? 'text-center mx-auto items-center' : 'text-left items-start';
---

<div class={`flex flex-col space-y-5 max-w-3xl ${alignClass} ${className}`}>
  {eyebrow && (
    <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 text-xs font-mono tracking-widest uppercase rounded-full bg-white/[0.05] text-neutral-300 w-fit">
      <span class="w-1.5 h-1.5 rounded-full bg-hst-red shadow-[0_0_8px_rgba(255,38,38,0.8)] animate-pulse"></span>
      <span>{eyebrow}</span>
    </div>
  )}

  <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.08] text-white text-balance">
    {title}
  </h2>

  {description && (
    <p class="text-base sm:text-xl leading-relaxed text-neutral-400 font-normal">
      {description}
    </p>
  )}
</div>
