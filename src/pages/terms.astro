---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';

const lastUpdated = "October 2026";
---

<BaseLayout
  title="Terms of Use — HackerSpace Technologies"
  description="Terms of Use and legal notices governing the access and utilization of HackerSpace Technologies digital properties."
  theme="dark"
>
  <section class="py-20 lg:py-24 bg-[#000000] text-white border-b border-white/10 bg-grid-subtle-dark">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-mono tracking-widest uppercase text-hst-red font-bold">
          Legal Framework
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">
          Terms of Use
        </h1>
        <p class="text-sm font-mono text-neutral-400">
          Effective Date: {lastUpdated} • Version 1.1
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-[#000000] text-neutral-300">
    <div class="max-w-reading mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white border-b border-white/10 pb-2">
          1. Acceptance of Terms
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-neutral-400">
          By accessing or browsing this website (<a href={siteConfig.url} class="text-hst-red hover:underline font-mono">{siteConfig.url}</a>), you agree to comply with and be bound by these Terms of Use. If you do not agree to these terms, please refrain from using our digital properties.
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white border-b border-white/10 pb-2">
          2. Intellectual Property Rights
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-neutral-400">
          All content, software architecture, visual designs, brand assets, vector monograms, typography systems, product descriptions, and technical documentation hosted on this website are the proprietary intellectual property of <strong class="text-white">HackerSpace Technologies</strong> and its affiliates.
        </p>
        <p class="text-sm sm:text-base leading-relaxed text-neutral-400">
          The names “HackerSpace Technologies”, “HST”, “SurveySpace”, “TotoAdsIndia”, “Toto Motors”, and associated logos are trademarks of the company. You may not reproduce, reverse-engineer, redistribute, or create derivative works from our content without explicit prior written authorization.
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white border-b border-white/10 pb-2">
          3. Informational Purpose &amp; Forward-Looking Statements
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-neutral-400">
          The information presented on this website is for general informational and corporate positioning purposes. Descriptions of initiatives in “Development”, “Concept”, or “Incubation” phases represent internal engineering pursuits and forward-looking product concepts, not guarantees of commercial launch or performance benchmarks.
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white border-b border-white/10 pb-2">
          4. Acceptable Use
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-neutral-400">
          You agree not to engage in any activity that interferes with, disrupts, or compromises the security of this website, including but not limited to automated denial-of-service attempts, unauthorized vulnerability scanning, scraping of confidential assets, or submission of malicious scripts through contact endpoints.
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white border-b border-white/10 pb-2">
          5. Disclaimer of Warranties &amp; Limitation of Liability
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-neutral-400">
          This website is provided on an “as is” and “as available” basis without warranties of any kind, whether express or statutory. HackerSpace Technologies disclaims all liability for any direct, indirect, incidental, or consequential damages arising from your access to or inability to access this website.
        </p>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white border-b border-white/10 pb-2">
          6. Contact &amp; Governance
        </h2>
        <p class="text-sm sm:text-base leading-relaxed text-neutral-400">
          These terms are governed by the laws of India. Any questions regarding these terms should be addressed to our legal department at <a href="mailto:contact@hackerspace.technologies" class="text-hst-red hover:underline font-mono">contact@hackerspace.technologies</a>.
        </p>
      </div>

    </div>
  </section>
</BaseLayout>
