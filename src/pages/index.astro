  <!-- Client-side Interactive Scripts: Phantom Horizontal Track + Scroll Color Animation -->
  <script is:inline>
    // 1. Scroll-triggered solid background color transition (Phantom-style)
    function setupScrollColorTransition() {
      const sections = document.querySelectorAll('section[data-bg-color]');
      if (!sections.length) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const targetColor = entry.target.getAttribute('data-bg-color');
            if (targetColor) {
              document.body.style.backgroundColor = targetColor;
            }
          }
        });
      }, {
        root: null,
        threshold: 0.25,
        rootMargin: '-10% 0px -10% 0px'
      });

      sections.forEach((sec) => observer.observe(sec));
    }

    // 2. Phantom-Style Horizontal Side-Scroll Track for Ventures
    function setupHorizontalVenturesTrack() {
      const track = document.getElementById('ventures-horizontal-track');
      const leftBtn = document.getElementById('ventures-scroll-left');
      const rightBtn = document.getElementById('ventures-scroll-right');
      const counterEl = document.getElementById('ventures-track-counter');
      const filterButtons = document.querySelectorAll('.venture-filter-btn');
      const cardWrappers = document.querySelectorAll('.venture-card-wrapper');

      if (!track) return;

      // Card width for step navigation
      const getScrollStep = () => {
        const firstCard = track.querySelector('.venture-card-wrapper');
        return firstCard ? firstCard.offsetWidth + 24 : 420;
      };

      // Button controls
      if (leftBtn) {
        leftBtn.addEventListener('click', () => {
          track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
        });
      }
      if (rightBtn) {
        rightBtn.addEventListener('click', () => {
          track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
        });
      }

      // Drag to scroll on desktop
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      track.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      window.addEventListener('mouseup', () => {
        isDown = false;
      });

      track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.6;
        track.scrollLeft = scrollLeft - walk;
      });

      // Update slide counter on scroll
      track.addEventListener('scroll', () => {
        const step = getScrollStep();
        const currentIdx = Math.min(Math.max(Math.round(track.scrollLeft / step) + 1, 1), 9);
        if (counterEl) {
          counterEl.textContent = `0${currentIdx} / 09`;
        }
      }, { passive: true });

      // Filter handling in horizontal track
      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Update active button state
          filterButtons.forEach(b => {
            b.classList.remove('bg-hst-red', 'text-white');
            b.classList.add('bg-[#141414]', 'text-neutral-400');
          });
          btn.classList.add('bg-hst-red', 'text-white');
          btn.classList.remove('bg-[#141414]', 'text-neutral-400');

          // Filter card display & reset scroll position
          let matchCount = 0;
          cardWrappers.forEach(card => {
            const cat = card.getAttribute('data-category') || '';
            let matches = false;
            if (filter === 'all') matches = true;
            else if (filter === 'software' && (cat.includes('software') || cat.includes('survey') || cat.includes('web'))) matches = true;
            else if (filter === 'mobility' && (cat.includes('mobility') || cat.includes('transit') || cat.includes('battery') || cat.includes('energy') || cat.includes('advertising'))) matches = true;
            else if (filter === 'ai' && (cat.includes('ai') || cat.includes('legal') || cat.includes('health') || cat.includes('well-being'))) matches = true;
            else if (filter === 'media' && (cat.includes('media') || cat.includes('gaming') || cat.includes('audio'))) matches = true;

            if (matches) {
              card.style.display = 'flex';
              matchCount++;
            } else {
              card.style.display = 'none';
            }
          });

          track.scrollTo({ left: 0, behavior: 'smooth' });
          if (counterEl) {
            counterEl.textContent = `01 / 0${matchCount}`;
          }
        });
      });
    }

    // Initialize on both standard load and Astro view transitions
    function initHomepageEnhancements() {
      setupScrollColorTransition();
      setupHorizontalVenturesTrack();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHomepageEnhancements);
    } else {
      initHomepageEnhancements();
    }
    document.addEventListener('astro:page-load', initHomepageEnhancements);
  </script>
