---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { siteConfig } from '../data/site';
import { getPath } from '../utils/paths';

const principles = [
  {
    number: '01',
    title: 'First-Principles Engineering',
    description: 'We do not clone existing products or build to satisfy consensus trends. We break problems down to their fundamental truths and engineer solutions from the ground up.'
  },
  {
    number: '02',
    title: 'Independence & Long Horizons',
    description: 'Being privately held and self-directed enables us to prioritize product longevity, engineering integrity, and genuine user value over artificial quarterly growth targets.'
  },
  {
    number: '03',
    title: 'Physical & Digital Convergence',
    description: 'We reject the artificial barrier between pure software and physical engineering. The most consequential systems integrate digital intelligence with real-world infrastructure.'
  },
  {
    number: '04',
    title: 'Precision & Factual Transparency',
    description: 'We let our code, uptime, and products speak. We never exaggerate capabilities, fabricate credentials, or obscure technical limitations.'
  }
];
---

<BaseLayout
  title="About HackerSpace Technologies — Independent Product Engineering"
  description="Learn about the origin, mission, operating philosophy, and technical standards of HackerSpace Technologies (HST)."
  theme="dark"
>
  <!-- Page Hero Header -->
  <section class="py-24 lg:py-32 bg-[#000000] text-white relative overflow-hidden bg-grid-subtle-dark">
    <!-- Ambient Radial Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(255,38,38,0.2),transparent_75%)] pointer-events-none"></div>

    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.05] text-xs font-mono tracking-widest uppercase text-neutral-300">
          <span class="w-1.5 h-1.5 rounded-full bg-hst-red animate-pulse"></span>
          <span>// Identity &amp; Origin</span>
        </div>
        <h1 class="text-5xl sm:text-7xl font-extrabold tracking-[-0.04em] leading-[1.04] text-gradient-silver">
          Building Technology.<br />
          <span class="text-gradient-red">Creating Possibilities.</span>
        </h1>
        <p class="text-xl sm:text-2xl text-neutral-400 leading-relaxed font-normal">
          HackerSpace Technologies is an independent technology company founded to build digital products, intelligent software, and technology-driven businesses across multiple industries.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 1: The HST Origin & Thesis -->
  <section class="py-24 bg-[#000000] text-white relative overflow-hidden">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-5 space-y-4">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-hst-red">01 / Foundation</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
            Why HackerSpace Technologies Exists
          </h2>
          <p class="text-sm font-mono text-neutral-500">
            From focused experiments to an enduring multi-venture company.
          </p>
        </div>

        <div class="lg:col-span-7 space-y-6 text-neutral-400 text-base sm:text-lg leading-relaxed">
          <p class="text-xl sm:text-2xl text-white font-medium">
            The name “HackerSpace” represents an uncompromising mindset: hands-on craftsmanship, unconstrained technical curiosity, and an insistence on building real things that function.
          </p>
          <p>
            Too much of the technology ecosystem is consumed with superficial wrappers, derivative templates, and speculative marketing claims. We established HST as an antidote — an organization dedicated to the deliberate craft of product engineering.
          </p>
          <p>
            Our portfolio is intentionally diversified. We build web platforms like SurveySpace to give researchers clean data instruments. Simultaneously, we pioneer urban mobility solutions like TotoAdsIndia and Toto Motors, merging electric vehicles with physical transit advertising and light manufacturing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Operating Principles -->
  <section class="py-24 bg-[#000000] text-white relative overflow-hidden">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <SectionHeader
        eyebrow="// Principles"
        title="How We Think and Operate"
        description="Four foundational tenets that govern our technology decisions, architecture standards, and venture governance."
        theme="dark"
        className="mb-16"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {principles.map((p) => (
          <div class="card-fluid p-8 rounded-2xl transition-all space-y-4">
            <span class="text-2xl font-mono font-bold text-hst-red block">{p.number}</span>
            <h3 class="text-2xl font-bold tracking-tight text-white">{p.title}</h3>
            <p class="text-sm text-neutral-400 leading-relaxed">{p.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: The Venture Studio Model -->
  <section class="py-24 bg-[#000000] text-white relative overflow-hidden">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-hst-red">02 / Architecture</span>
          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
            A Unified Platform For Independent Ventures
          </h2>
          <p class="text-base text-neutral-400 leading-relaxed">
            HackerSpace Technologies operates as the parent architecture, providing core engineering disciplines, shared infrastructure, and technical leadership. Each venture maintains focused product sovereignty while benefiting from cross-disciplinary insights.
          </p>
          <ul class="space-y-4 text-sm text-neutral-300">
            <li class="flex items-center gap-3">
              <span class="text-hst-red font-mono font-bold text-base">✓</span>
              <span>Proprietary intellectual property ownership across all ventures</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-hst-red font-mono font-bold text-base">✓</span>
              <span>Zero external debt; disciplined capital allocation</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="text-hst-red font-mono font-bold text-base">✓</span>
              <span>Direct transition from R&D prototypes to operating commercial entities</span>
            </li>
          </ul>
          <div class="pt-4">
            <a href={getPath('/ventures')} class="inline-flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-hst-red hover:text-white transition-colors">
              <span>Inspect Venture Portfolio</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 p-8 sm:p-10 rounded-3xl bg-white/[0.03] backdrop-blur-xl text-white space-y-6 shadow-2xl">
          <h3 class="text-xl font-bold tracking-tight text-white pb-2">
            Ecosystem Composition
          </h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/[0.04] hover:bg-white/[0.07] transition-all">
              <span class="text-sm font-semibold text-neutral-200">Software &amp; Digital Platforms</span>
              <span class="text-xs font-mono text-hst-red">SurveySpace, ScrollTax, GameSpace</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/[0.04] hover:bg-white/[0.07] transition-all">
              <span class="text-sm font-semibold text-neutral-200">Mobility &amp; Transit Networks</span>
              <span class="text-xs font-mono text-hst-red">TotoAdsIndia, Toto Motors</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/[0.04] hover:bg-white/[0.07] transition-all">
              <span class="text-sm font-semibold text-neutral-200">Applied AI &amp; Clean Energy</span>
              <span class="text-xs font-mono text-hst-red">LegalAI, Battery Systems R&amp;D</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/[0.04] hover:bg-white/[0.07] transition-all">
              <span class="text-sm font-semibold text-neutral-200">Media &amp; Human Wellness</span>
              <span class="text-xs font-mono text-hst-red">HealthSpace, AudioSpace</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-24 bg-[#000000] text-white text-center">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
        Ready to collaborate with HackerSpace Technologies?
      </h2>
      <p class="text-neutral-400 max-w-xl mx-auto text-sm sm:text-base">
        Explore partnership opportunities, product collaborations, or reach out to our team directly.
      </p>
      <div class="pt-4">
        <a href={getPath('/contact')} class="px-8 py-4 text-xs font-bold tracking-widest uppercase text-white bg-hst-red hover:bg-hst-red-hover rounded-full transition-all inline-block shadow-xl shadow-hst-red/30 hover:scale-105 active:scale-95">
          Initiate Contact
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
