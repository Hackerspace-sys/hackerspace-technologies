---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { capabilities, approachSteps } from '../data/capabilities';
import { getPath } from '../utils/paths';
---

<BaseLayout
  title="Innovation & Capabilities — HackerSpace Technologies"
  description="Explore the technical capabilities, engineering disciplines, and product development philosophy of HackerSpace Technologies."
  theme="dark"
>
  <!-- Page Header -->
  <section class="py-24 lg:py-32 bg-[#000000] text-white relative overflow-hidden bg-grid-subtle-dark">
    <!-- Ambient Radial Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(255,38,38,0.2),transparent_75%)] pointer-events-none"></div>

    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/[0.05] text-xs font-mono tracking-widest uppercase text-neutral-300">
          <span class="w-1.5 h-1.5 rounded-full bg-hst-red animate-pulse"></span>
          <span>// Engineering Standards</span>
        </div>
        <h1 class="text-5xl sm:text-7xl font-extrabold tracking-[-0.04em] leading-[1.04] text-gradient-silver">
          From Ideas to Real-World Products.
        </h1>
        <p class="text-xl sm:text-2xl text-neutral-400 leading-relaxed font-normal">
          An architectural breakdown of the disciplines, development standards, and physical-meets-digital capabilities at HackerSpace Technologies.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Disciplines Deep Dive -->
  <section class="py-24 bg-[#000000] text-white relative overflow-hidden">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <SectionHeader
        eyebrow="// Capabilities"
        title="Core Engineering Competencies"
        description="Our capabilities bridge high-performance digital platforms with physical mobility hardware, transit ad systems, and energy storage engineering."
        theme="dark"
        className="mb-16"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {capabilities.map((cap) => (
          <div class="card-fluid p-8 rounded-2xl flex flex-col justify-between group hover:-translate-y-1.5 transition-all">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="text-2xl font-mono font-extrabold text-hst-red">{cap.number}</span>
                <span class="text-xs font-mono text-neutral-400 uppercase">Discipline</span>
              </div>
              <h3 class="text-2xl font-bold tracking-tight text-white mb-3">
                {cap.title}
              </h3>
              <p class="text-sm text-neutral-400 leading-relaxed mb-6">
                {cap.description}
              </p>
            </div>

            <div class="pt-4 flex flex-wrap gap-2">
              {cap.subDisciplines.map((sub) => (
                <span class="text-[11px] font-mono px-2.5 py-1 rounded-full bg-white/[0.04] text-neutral-300 group-hover:bg-white/[0.08] transition-colors">
                  {sub}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Operating Methodology -->
  <section class="py-24 bg-[#000000] text-white relative overflow-hidden">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <SectionHeader
        eyebrow="// Process"
        title="The HST Product Architecture Lifecycle"
        description="Every initiative progresses through four deliberate stages of validation, architecture, engineering, and empirical feedback."
        theme="dark"
        className="mb-16"
      />

      <div class="laser-track mb-12 hidden lg:block"></div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {approachSteps.map((step) => (
          <div class="card-fluid p-7 rounded-2xl flex flex-col justify-between space-y-6 group hover:-translate-y-1 transition-all">
            <div class="flex items-center justify-between">
              <span class="text-3xl font-extrabold font-mono text-hst-red">{step.step}</span>
              <span class="text-[10px] font-mono uppercase text-neutral-400">Stage</span>
            </div>
            <div class="space-y-3">
              <h3 class="text-lg font-bold text-white tracking-tight">{step.title}</h3>
              <p class="text-xs text-neutral-400 leading-relaxed">{step.description}</p>
            </div>
            <div class="pt-4">
              <span class="text-[10px] font-mono uppercase text-neutral-500 block mb-1">Standard Output</span>
              <span class="text-xs text-neutral-300 font-mono font-medium">{step.deliverables}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Standard Section -->
  <section class="py-24 bg-[#000000] text-white relative overflow-hidden">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="p-10 sm:p-14 rounded-3xl bg-gradient-to-r from-white/[0.04] to-transparent backdrop-blur-xl flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl">
          <span class="text-xs font-mono font-bold uppercase text-hst-red tracking-widest block">System Hygiene</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
            Zero-Bloat, Static-First Infrastructure
          </h2>
          <p class="text-base text-neutral-400 leading-relaxed">
            We adhere to strict engineering hygiene: sub-second page loads, zero unnecessary client-side JavaScript, resilient edge hosting on Cloudflare, and deterministic builds.
          </p>
        </div>
        <div class="flex-shrink-0">
          <a
            href={getPath('/contact')}
            class="inline-block px-8 py-4 text-xs font-bold uppercase tracking-widest text-white bg-hst-red hover:bg-hst-red-hover rounded-full transition-all shadow-xl shadow-hst-red/30 hover:scale-105 active:scale-95"
          >
            Initiate Technical Inquiry
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
