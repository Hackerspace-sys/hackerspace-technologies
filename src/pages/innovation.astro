---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { capabilities, approachSteps } from '../data/capabilities';
---

<BaseLayout
  title="Innovation & Capabilities — HackerSpace Technologies"
  description="Explore the technical capabilities, engineering disciplines, and product development philosophy of HackerSpace Technologies."
  theme="dark"
>
  <!-- Page Header -->
  <section class="py-20 lg:py-28 bg-[#050505] text-white border-b border-white/10 bg-grid-subtle-dark">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-mono tracking-widest uppercase text-hst-red">
          <span>// Engineering Standards</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-[1.08]">
          From Ideas to Real-World Products.
        </h1>
        <p class="text-lg sm:text-xl text-neutral-300 leading-relaxed font-normal">
          An architectural breakdown of the disciplines, development standards, and physical-meets-digital capabilities at HackerSpace Technologies.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Disciplines Deep Dive -->
  <section class="py-24 bg-white text-neutral-900 border-b border-neutral-200">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="// Capabilities"
        title="Core Engineering Competencies"
        description="Our capabilities bridge high-performance digital platforms with physical mobility hardware, transit ad systems, and energy storage engineering."
        theme="light"
        className="mb-16"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {capabilities.map((cap) => (
          <div class="p-8 rounded-lg border border-neutral-200 bg-white hover:border-hst-red/50 hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-6 mb-6 border-b border-neutral-100">
                <span class="text-xs font-mono font-bold text-hst-red">{cap.number}</span>
                <span class="text-xs font-mono text-neutral-400 uppercase">Discipline</span>
              </div>
              <h3 class="text-xl font-bold tracking-tight text-neutral-900 mb-3">
                {cap.title}
              </h3>
              <p class="text-sm text-neutral-600 leading-relaxed mb-6">
                {cap.description}
              </p>
            </div>

            <div class="pt-4 border-t border-neutral-100">
              <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-400 block mb-2">Technical Areas</span>
              <div class="flex flex-wrap gap-1.5">
                {cap.subDisciplines.map((sub) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-700">
                    {sub}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Operating Methodology -->
  <section class="py-24 bg-[#0A0A0C] text-white border-b border-white/10">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="// Process"
        title="The HST Product Architecture Lifecycle"
        description="Every initiative progresses through four deliberate stages of validation, architecture, engineering, and empirical feedback."
        theme="dark"
        className="mb-16"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {approachSteps.map((step) => (
          <div class="p-6 rounded-lg border border-white/10 bg-[#121215] flex flex-col justify-between space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-3xl font-extrabold font-mono text-hst-red">{step.step}</span>
              <span class="text-[10px] font-mono uppercase text-neutral-500">Stage</span>
            </div>
            <div class="space-y-3">
              <h3 class="text-lg font-bold text-white tracking-tight">{step.title}</h3>
              <p class="text-xs text-neutral-400 leading-relaxed">{step.description}</p>
            </div>
            <div class="pt-4 border-t border-white/5">
              <span class="text-[10px] font-mono uppercase text-neutral-500 block mb-1">Standard Output</span>
              <span class="text-xs text-neutral-300 font-mono font-medium">{step.deliverables}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Standard Section -->
  <section class="py-20 bg-white text-neutral-900">
    <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center p-8 sm:p-12 rounded-2xl bg-neutral-50 border border-neutral-200">
        <div class="lg:col-span-8 space-y-4">
          <span class="text-xs font-mono font-bold uppercase text-hst-red">System Hygiene</span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900">
            Zero-Bloat, Static-First Infrastructure
          </h2>
          <p class="text-sm sm:text-base text-neutral-600 leading-relaxed">
            We adhere to strict engineering hygiene: sub-second page loads, zero unnecessary client-side JavaScript, resilient edge hosting on Cloudflare, and deterministic builds.
          </p>
        </div>
        <div class="lg:col-span-4 text-left lg:text-right">
          <a
            href="/contact"
            class="inline-block px-6 py-3.5 text-xs font-semibold uppercase tracking-wider text-white bg-hst-red hover:bg-hst-red-hover rounded-sm transition-colors"
          >
            Initiate Technical Inquiry
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
