# ==============================================================================
# HackerSpace Technologies (HST) — Environment Configuration Template
# ==============================================================================
# Note: The website is architected with a strict ₹0 infrastructure budget and runs
# as a 100% pre-rendered static site. No secret environment variables or paid API
# keys are required for normal production builds and deployment.
# ==============================================================================

# Production Site URL
PUBLIC_SITE_URL=https://hackerspace-technologies.pages.dev

# Contact Form Optional Endpoint (e.g. Formspree or Cloudflare Worker if desired)
# Defaults to direct mailto client fallback when omitted
PUBLIC_CONTACT_ENDPOINT=

# Optional Analytics (Zero-cost, privacy-friendly analytics if desired)
PUBLIC_ANALYTICS_ID=
